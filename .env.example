# 拷成 .env（已 gitignore）后填入自己的 key。⛔ 本文件不含真实密钥。
# 配置文件（configs/backbone/*.toml）里存的是**变量名**，值只在这里。

# OpenAI 兼容端点
# ⚠️ base_url 已含 /v1——代码只在后面接 /embeddings、/chat/completions。
#    不带会 404，带两次（/v1/v1/…）也会 404。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1

# backbone：⛔ 跑 answer 档时所有系统必须用同一个，否则分数不可比
AMB_LLM_MODEL=Qwen/Qwen3-8B
AMB_LLM_BASE_URL=https://api.siliconflow.com/v1
AMB_LLM_API_KEY_ENV=SILICONFLOW_API_KEY

# embedding：⚠️ 必须与被测系统用的同一个，否则差别里混进了 embedder
AMB_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
AMB_EMBED_BASE_URL=https://api.siliconflow.com/v1
AMB_EMBED_API_KEY_ENV=SILICONFLOW_API_KEY
